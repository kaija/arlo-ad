# Copy to .env and fill in. Never commit .env (Requirement 20.6).
# docker-compose.yml overrides DATABASE_URL to point at its postgres service.

# --- App ----------------------------------------------------------------------
DATABASE_URL=postgres://arlo:arlo@localhost:5432/arlo
APP_BASE_URL=http://localhost:3000
# Public hostname Caddy serves with automatic TLS (docker-compose.prod.yml).
APP_DOMAIN=ads-bot.example.com
LOG_LEVEL=info
WORKER_HEALTH_PORT=9090

# --- Web auth: Google Workspace SSO (ADR-0010) --------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
ALLOWED_WORKSPACE_DOMAIN=example.com

# --- Slack (ADR-0005, ADR-0011) -----------------------------------------------
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APPROVAL_CHANNEL_ID=
SLACK_OPS_CHANNEL_ID=

# --- Google Ads (ADR-0004) ----------------------------------------------------
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Comma-separated customer IDs the Executor may mutate. Dev: test accounts only (ADR-0026).
ADS_WRITE_ALLOWED_CUSTOMER_IDS=

# --- GA4 (ADR-0021), optional -------------------------------------------------
# Service account key JSON on one line.
GA4_SERVICE_ACCOUNT_JSON=

# --- LLM (ADR-0023, ADR-0024) -------------------------------------------------
OPENAI_API_KEY=
MODEL_FLAGSHIP=
MODEL_SMALL=
DAILY_LLM_BUDGET_USD=30

# --- Backups (ADR-0025), optional ---------------------------------------------
BACKUP_S3_BUCKET=
