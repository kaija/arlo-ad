# Copy to .env and fill in. Never commit .env (Requirement 20.6).
# docker-compose.yml overrides DATABASE_URL to point at its postgres service.

# --- App ----------------------------------------------------------------------
DATABASE_URL=postgres://arlo:arlo@localhost:5432/arlo
APP_BASE_URL=http://localhost:3000
# Public hostname Caddy serves with automatic TLS (docker-compose.prod.yml).
APP_DOMAIN=ads-bot.example.com
LOG_LEVEL=info
WORKER_HEALTH_PORT=9090
# Dev server only (next dev): comma-separated hosts allowed to load dev resources, e.g. 52.69.30.82,dev.example.com
ALLOWED_DEV_ORIGINS=

# --- Production compose (docker-compose.prod.yml) -----------------------------
# Embedded in DATABASE_URL by compose; generate URL-safe: openssl rand -hex 32
POSTGRES_PASSWORD=
# Host path of the dedicated EBS volume for Postgres data (default /data/pg).
# PG_DATA_DIR=/data/pg

# --- Web auth: Google Workspace SSO (ADR-0010) --------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional. Leave empty to let any verified Google account sign in (no role until an admin grants one).
ALLOWED_WORKSPACE_DOMAIN=example.com

# --- Slack (ADR-0005, ADR-0011) -----------------------------------------------
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APPROVAL_CHANNEL_ID=
SLACK_OPS_CHANNEL_ID=

# --- Google Ads (ADR-0004) ----------------------------------------------------
# Deprecated, optional. Google retired developer tokens on 2026-09-09: access level now comes from
# the Google Cloud project that owns the OAuth client. Leave empty (docs/setup/google-ads.md).
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Comma-separated customer IDs the Executor may mutate. Dev: test accounts only (ADR-0026).
ADS_WRITE_ALLOWED_CUSTOMER_IDS=

# --- GA4 (ADR-0021), optional -------------------------------------------------
# Service account key JSON on one line.
GA4_SERVICE_ACCOUNT_JSON=

# --- LLM (ADR-0023, ADR-0024) -------------------------------------------------
OPENAI_API_KEY=
MODEL_FLAGSHIP=
MODEL_SMALL=
DAILY_LLM_BUDGET_USD=30

# --- Backups (ADR-0025): scripts/backup.sh, scripts/restore.sh ----------------
BACKUP_S3_BUCKET=
# Slack incoming webhook for backup failure alerts (ops channel).
SLACK_OPS_WEBHOOK_URL=
