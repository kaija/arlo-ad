{
  "suite": "search_term_classifier",
  "description": "搜尋字詞分類器對照 Business Profile 判斷相關性；自動排除門檻（confidence ≥ 0.9）的 precision 需 ≥ 0.98（Requirement 14.4，ADR-0019）。",
  "agent": "search_term_classifier",
  "minPassRate": 0.85,
  "precisionAt": {
    "threshold": 0.9,
    "min": 0.98
  },
  "fixture": {
    "profile": {
      "offerings": [
        "家用無線監視器",
        "戶外防水監視攝影機",
        "視訊門鈴 Video Doorbell",
        "居家安全監控訂閱方案"
      ],
      "targetIntents": [
        "購買",
        "價格比較",
        "型號比較",
        "評測推薦",
        "安裝需求"
      ],
      "excludedIntents": [
        "免費",
        "破解",
        "求職",
        "二手",
        "DIY 自製",
        "維修教學"
      ],
      "brandTerms": [
        "arlo"
      ],
      "competitorPolicy": "exclude",
      "examples": [
        {
          "term": "arlo 客服電話",
          "relevant": true,
          "note": "既有客戶支援，保留"
        },
        {
          "term": "監視器 app 免費下載",
          "relevant": false,
          "note": null
        }
      ]
    }
  },
